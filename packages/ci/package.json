{
  "name": "@putitoutthere/ci",
  "version": "0.0.0",
  "description": "Repo-internal CI gates for putitoutthere. Private; never published.",
  "private": true,
  "type": "module",
  "bin": {
    "piot-ci": "./dist/cli-bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run src",
    "test:integration": "vitest run --config tests/integration/vitest.integration.config.ts",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "putitoutthere": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
